{
  "name": "pi-ssh-remote-run",
  "version": "0.1.0",
  "description": "Pi coding agent extension: local development, remote run & debug over a persistent SSH connection",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package", "pi-extension", "ssh", "remote-development"],
  "pi": {
    "extensions": ["./src"],
    "skills": ["./skills"]
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/"
  },
  "dependencies": {
    "typebox": "^1.1.24"
  },
  "devDependencies": {
    "@mariozechner/pi-coding-agent": "^0.73.1",
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*"
  }
}
